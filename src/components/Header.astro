---
import { Icon } from 'astro-icon/components';
import { config } from '../config';

const navItems = [
  { name: 'O nas', href: '/o-nas' },
  { name: 'Oferta', href: '/oferta' },
  { name: 'Kontakt', href: '/kontakt' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 bg-white border-b border-neutral-200">
  <div class="max-w-6xl mx-auto px-4 lg:px-6">
    <div class="flex items-center h-18 lg:h-20">
      <a href="/" class="shrink-0 font-bold text-xl tracking-tight text-neutral-900">
        {config.siteName}
      </a>

      <nav class="hidden lg:flex items-center justify-center gap-1 flex-1 ml-10">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'inline-flex items-center px-4 py-2.5 text-sm font-medium rounded-lg transition-colors',
                isActive(item.href) ? 'text-orange-600 font-semibold' : 'text-neutral-600 hover:text-neutral-900',
              ]}
            >
              {item.name}
            </a>
          ))
        }
      </nav>

      <a
        href="/kontakt"
        class="hidden lg:inline-flex shrink-0 items-center gap-1.5 bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors whitespace-nowrap ml-auto"
      >
        Umów rozmowę
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden ml-auto p-2 text-neutral-700 hover:bg-neutral-100 rounded-lg transition-colors"
        aria-label="Otwórz menu"
        aria-expanded="false"
      >
        <Icon name="lucide:menu" class="w-6 h-6 icon-open" />
        <Icon name="lucide:x" class="w-6 h-6 icon-close hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile drawer overlay -->
  <div
    id="mobile-drawer-overlay"
    class="lg:hidden fixed inset-0 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <div id="mobile-drawer-backdrop" class="absolute inset-0 bg-black/40"></div>

    <div
      id="mobile-drawer-panel"
      class="absolute top-0 right-0 h-full w-72 bg-white border-l border-neutral-200 shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-in-out"
    >
      <div class="flex items-center justify-between px-4 h-18 border-b border-neutral-200 shrink-0">
        <a href="/" class="font-bold text-lg text-neutral-900">{config.siteName}</a>
        <button
          id="mobile-drawer-close"
          type="button"
          class="p-2 text-neutral-500 hover:bg-neutral-100 rounded-lg transition-colors"
          aria-label="Zamknij menu"
        >
          <Icon name="lucide:x" class="w-5 h-5" />
        </button>
      </div>

      <nav class="flex-1 overflow-y-auto px-3 py-4">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors',
                isActive(item.href) ? 'text-orange-600 bg-orange-50 font-semibold' : 'text-neutral-700 hover:bg-neutral-100',
              ]}
            >
              {item.name}
            </a>
          ))
        }
      </nav>

      <div class="shrink-0 px-3 pb-5 border-t border-neutral-200 pt-3">
        <a
          href="/kontakt"
          class="flex items-center justify-center bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold px-4 py-3 rounded-lg transition-colors"
        >
          Umów rozmowę
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const overlay = document.getElementById('mobile-drawer-overlay');
  const panel = document.getElementById('mobile-drawer-panel');
  const backdrop = document.getElementById('mobile-drawer-backdrop');
  const closeBtn = document.getElementById('mobile-drawer-close');
  const iconOpen = toggle?.querySelector('.icon-open');
  const iconClose = toggle?.querySelector('.icon-close');

  function setOpen(open: boolean) {
    if (!overlay || !panel || !toggle) return;
    overlay.classList.toggle('opacity-100', open);
    overlay.classList.toggle('pointer-events-auto', open);
    overlay.classList.toggle('opacity-0', !open);
    overlay.classList.toggle('pointer-events-none', !open);
    panel.classList.toggle('translate-x-full', !open);
    panel.classList.toggle('translate-x-0', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setOpen(!panel?.classList.contains('translate-x-0')));
  backdrop?.addEventListener('click', () => setOpen(false));
  closeBtn?.addEventListener('click', () => setOpen(false));
  overlay?.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
