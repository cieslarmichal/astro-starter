---
export type Stat = { value: string; label: string; desc: string };

type Theme = 'flat' | 'elevated';

const themes = {
  flat: { section: 'bg-black' },
  elevated: { section: 'bg-neutral-950 border-y border-white/10' },
} satisfies Record<Theme, Record<string, string>>;

interface Props {
  theme?: Theme;
  eyebrow: string;
  stats: Stat[];
}

const { theme = 'elevated', eyebrow, stats } = Astro.props;
const t = themes[theme];
---

<section class={`py-14 lg:py-20 ${t.section}`}>
  <div class="max-w-6xl mx-auto px-4 lg:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest mb-6 text-orange-400">{eyebrow}</p>
    <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-white/10">
      {
        stats.map(({ value, label, desc }) => (
          <div class="flex flex-col py-5 first:pt-0 last:pb-0 sm:py-0 sm:px-8 sm:first:pl-0 sm:last:pr-0">
            <p class="text-5xl lg:text-6xl font-black leading-none mb-2 text-orange-400">{value}</p>
            <p class="text-base font-bold mb-1 text-white">{label}</p>
            <p class="text-sm leading-relaxed text-neutral-400">{desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
