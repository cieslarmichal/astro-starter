---
interface Props {
  label: string;
  title: string;
  description: string;
}
const { label, title, description } = Astro.props;
---

<section class="bg-neutral-50 border-b border-neutral-200 py-14 lg:py-20 px-4">
  <div class="max-w-6xl mx-auto text-center">
    <p class="text-orange-600 text-xs font-semibold uppercase tracking-widest mb-3">{label}</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 leading-tight mb-3">{title}</h1>
    <p class="text-neutral-500 text-base max-w-2xl mx-auto leading-relaxed">{description}</p>
  </div>
</section>
