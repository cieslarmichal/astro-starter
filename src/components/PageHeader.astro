---
interface Props {
  label: string;
  title: string;
  description: string;
}
const { label, title, description } = Astro.props;
---

<section class="relative bg-black border-b border-white/10 py-14 lg:py-20 px-4 overflow-hidden">
  <div
    class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[400px] rounded-full bg-orange-600/10 blur-3xl"
  >
  </div>
  <div class="relative max-w-6xl mx-auto text-center">
    <p class="text-orange-400 text-xs font-semibold uppercase tracking-widest mb-3">{label}</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-3">{title}</h1>
    <p class="text-neutral-400 text-base max-w-2xl mx-auto leading-relaxed">{description}</p>
  </div>
</section>
