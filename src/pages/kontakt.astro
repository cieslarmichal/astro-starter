---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import { config } from '../config';
import { createBreadcrumbStructuredData, createLocalBusinessStructuredData } from '../lib/structuredData';

const title = `Kontakt — ${config.siteName}`;
const description = `Skontaktuj się z ${config.siteName}. Odpowiadamy w ciągu jednego dnia roboczego.`;
const canonical = `${config.siteUrl}/kontakt`;

const jsonLd = [
  createBreadcrumbStructuredData([
    { name: 'Strona główna', url: config.siteUrl },
    { name: 'Kontakt', url: canonical },
  ]),
  createLocalBusinessStructuredData(),
];
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <PageHeader label="Kontakt" title="Porozmawiajmy" description="Napisz lub zadzwoń - odpowiadamy w ciągu jednego dnia roboczego." />

  <section class="bg-white py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 lg:px-6 grid lg:grid-cols-[1fr_1.3fr] gap-14">
      <!-- ── INFO ─────────────────────────────────────────── -->
      <div class="flex flex-col gap-6">
        <a href={`mailto:${config.contact.email}`} class="flex items-center gap-4 p-5 border border-neutral-200 rounded-xl hover:border-orange-300 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-orange-50 flex items-center justify-center shrink-0">
            <Icon name="lucide:mail" class="w-5 h-5 text-orange-600" />
          </div>
          <div>
            <p class="text-xs text-neutral-500">E-mail</p>
            <p class="font-semibold text-neutral-900">{config.contact.email}</p>
          </div>
        </a>

        <a href={config.contact.phoneHref} class="flex items-center gap-4 p-5 border border-neutral-200 rounded-xl hover:border-orange-300 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-orange-50 flex items-center justify-center shrink-0">
            <Icon name="lucide:phone" class="w-5 h-5 text-orange-600" />
          </div>
          <div>
            <p class="text-xs text-neutral-500">Telefon</p>
            <p class="font-semibold text-neutral-900">{config.contact.phone}</p>
          </div>
        </a>

        <a href={config.address.mapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-5 border border-neutral-200 rounded-xl hover:border-orange-300 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-orange-50 flex items-center justify-center shrink-0">
            <Icon name="lucide:map-pin" class="w-5 h-5 text-orange-600" />
          </div>
          <div>
            <p class="text-xs text-neutral-500">Adres</p>
            <p class="font-semibold text-neutral-900">{config.address.street}, {config.address.postalCode} {config.address.city}</p>
          </div>
        </a>

        <p class="text-xs text-neutral-400 leading-relaxed mt-2">
          {config.legalName} · NIP: {config.legal.nip} · REGON: {config.legal.regon} · KRS: {config.legal.krs}
        </p>
      </div>

      <!-- ── FORM ─────────────────────────────────────────── -->
      <div>
        <div id="form-success" class="hidden">
          <div class="bg-orange-50 border border-orange-200 rounded-xl px-6 py-10 text-center">
            <p class="text-3xl mb-3">✓</p>
            <p class="font-bold text-neutral-900 mb-1">Wiadomość wysłana!</p>
            <p class="text-sm text-neutral-500">Odpowiemy najszybciej, jak to możliwe.</p>
            <button type="button" id="form-send-another" class="mt-4 text-sm text-orange-600 underline hover:text-orange-700">
              Wyślij kolejną wiadomość
            </button>
          </div>
        </div>

        <form id="contact-form" class="space-y-5">
          <!--
            web3forms.com is free and needs no backend of your own: sign up,
            paste your access key into src/config.ts's web3formsAccessKey, and
            this form starts delivering mail. Swap the fetch() below for
            another provider if you'd rather use one.
          -->
          <input type="hidden" name="access_key" value={config.web3formsAccessKey} />
          <input type="hidden" name="subject" value={`Nowe zapytanie – ${config.siteName}`} />
          <!-- Honeypot: real users never fill this in; bots usually do. -->
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-neutral-700 mb-1.5">Imię i nazwisko</label>
              <input id="name" type="text" name="name" required placeholder="Jan Kowalski" class="w-full bg-white border border-neutral-300 text-neutral-900 placeholder-neutral-400 px-4 py-3 rounded-lg text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-neutral-700 mb-1.5">Numer telefonu</label>
              <input id="phone" type="tel" name="phone" placeholder="+48 000 000 000" class="w-full bg-white border border-neutral-300 text-neutral-900 placeholder-neutral-400 px-4 py-3 rounded-lg text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors" />
            </div>
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-neutral-700 mb-1.5">Adres e-mail</label>
            <input id="email" type="email" name="email" required placeholder="jan@example.com" class="w-full bg-white border border-neutral-300 text-neutral-900 placeholder-neutral-400 px-4 py-3 rounded-lg text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors" />
          </div>
          <div>
            <label for="message" class="block text-sm font-semibold text-neutral-700 mb-1.5">Wiadomość</label>
            <textarea id="message" name="message" rows="5" required placeholder="Napisz swoją wiadomość..." class="w-full bg-white border border-neutral-300 text-neutral-900 placeholder-neutral-400 px-4 py-3 rounded-lg text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors resize-none"></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input type="checkbox" id="rodo" required class="mt-0.5 accent-orange-600" />
            <label for="rodo" class="text-xs text-neutral-500 leading-relaxed">
              Wyrażam zgodę na przetwarzanie moich danych osobowych w celu udzielenia odpowiedzi na moje zapytanie,
              zgodnie z <a href="/polityka-prywatnosci" class="text-orange-600 hover:underline">Polityką prywatności</a>.
            </label>
          </div>

          <p id="form-error" class="hidden text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-4 py-3">
            Coś poszło nie tak. Spróbuj ponownie lub napisz bezpośrednio na
            <a href={`mailto:${config.contact.email}`} class="underline">{config.contact.email}</a>.
          </p>

          <button type="submit" id="form-submit" class="w-full bg-orange-600 hover:bg-orange-700 disabled:opacity-60 disabled:cursor-not-allowed text-white font-bold py-3.5 rounded-lg transition-colors text-sm">
            Wyślij wiadomość
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('form-submit') as HTMLButtonElement | null;
  const successBox = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');

  function setSubmitting(submitting: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = submitting;
    submitBtn.textContent = submitting ? 'Wysyłanie…' : 'Wyślij wiadomość';
  }

  function showSuccess(show: boolean) {
    successBox?.classList.toggle('hidden', !show);
    form?.classList.toggle('hidden', show);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox?.classList.add('hidden');
    setSubmitting(true);
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form),
      });
      const data = await res.json();
      if (data.success) {
        showSuccess(true);
        form.reset();
      } else {
        errorBox?.classList.remove('hidden');
      }
    } catch {
      errorBox?.classList.remove('hidden');
    } finally {
      setSubmitting(false);
    }
  });

  document.getElementById('form-send-another')?.addEventListener('click', () => showSuccess(false));
</script>
