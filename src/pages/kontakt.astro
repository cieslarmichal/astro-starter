---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import { config } from '../config';
import { createBreadcrumbStructuredData, createLocalBusinessStructuredData } from '../lib/structuredData';

const title = `Kontakt — ${config.siteName}`;
const description = `Skontaktuj się z ${config.siteName}. Odpowiadamy w ciągu jednego dnia roboczego.`;
const canonical = `${config.siteUrl}/kontakt`;

const jsonLd = [
  createBreadcrumbStructuredData([
    { name: 'Strona główna', url: config.siteUrl },
    { name: 'Kontakt', url: canonical },
  ]),
  createLocalBusinessStructuredData(),
];
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <PageHeader label="Kontakt" title="Porozmawiajmy" description="Napisz lub zadzwoń - odpowiadamy w ciągu jednego dnia roboczego." />

  <section class="bg-black py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 lg:px-6 grid lg:grid-cols-[1fr_1.3fr] gap-14">
      <!-- ── INFO ─────────────────────────────────────────── -->
      <div class="flex flex-col gap-6">
        <a href={`mailto:${config.contact.email}`} class="flex items-center gap-4 p-5 bg-neutral-950 border border-white/10 rounded-xl hover:border-orange-500/40 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-orange-500/10 flex items-center justify-center shrink-0">
            <Icon name="lucide:mail" class="w-5 h-5 text-orange-400" />
          </div>
          <div>
            <p class="text-xs text-neutral-500">E-mail</p>
            <p class="font-semibold text-white">{config.contact.email}</p>
          </div>
        </a>

        <a href={config.contact.phoneHref} class="flex items-center gap-4 p-5 bg-neutral-950 border border-white/10 rounded-xl hover:border-orange-500/40 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-orange-500/10 flex items-center justify-center shrink-0">
            <Icon name="lucide:phone" class="w-5 h-5 text-orange-400" />
          </div>
          <div>
            <p class="text-xs text-neutral-500">Telefon</p>
            <p class="font-semibold text-white">{config.contact.phone}</p>
          </div>
        </a>

        <a href={config.address.mapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-5 bg-neutral-950 border border-white/10 rounded-xl hover:border-orange-500/40 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-orange-500/10 flex items-center justify-center shrink-0">
            <Icon name="lucide:map-pin" class="w-5 h-5 text-orange-400" />
          </div>
          <div>
            <p class="text-xs text-neutral-500">Adres</p>
            <p class="font-semibold text-white">{config.address.street}, {config.address.postalCode} {config.address.city}</p>
          </div>
        </a>

        <p class="text-xs text-neutral-500 leading-relaxed mt-2">
          {config.legalName} · NIP: {config.legal.nip} · REGON: {config.legal.regon} · KRS: {config.legal.krs}
        </p>
      </div>

      <!-- ── FORM ─────────────────────────────────────────── -->
      <div>
        <div id="form-success" class="hidden">
          <div class="bg-orange-500/10 border border-orange-500/30 rounded-xl px-6 py-10 text-center">
            <p class="text-3xl mb-3">✓</p>
            <p class="font-bold text-white mb-1">Wiadomość wysłana!</p>
            <p class="text-sm text-neutral-400">Odpowiemy najszybciej, jak to możliwe.</p>
            <button type="button" id="form-send-another" class="mt-4 text-sm text-orange-400 underline hover:text-orange-300">
              Wyślij kolejną wiadomość
            </button>
          </div>
        </div>

        <form id="contact-form" class="space-y-5">
          <!--
            web3forms.com is free and needs no backend of your own: sign up,
            paste your access key into src/config.ts's web3formsAccessKey, and
            this form starts delivering mail. Swap the fetch() below for
            another provider if you'd rather use one.
          -->
          <input type="hidden" name="access_key" value={config.web3formsAccessKey} />
          <input type="hidden" name="subject" value={`Nowe zapytanie – ${config.siteName}`} />
          <!-- Honeypot: real users never fill this in; bots usually do. -->
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-neutral-300 mb-1.5">Imię i nazwisko</label>
              <input id="name" type="text" name="name" required placeholder="Jan Kowalski" class="w-full bg-neutral-950 border border-white/10 text-white placeholder-neutral-600 px-4 py-3 rounded-lg text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-neutral-300 mb-1.5">Numer telefonu</label>
              <input id="phone" type="tel" name="phone" placeholder="+48 000 000 000" class="w-full bg-neutral-950 border border-white/10 text-white placeholder-neutral-600 px-4 py-3 rounded-lg text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors" />
            </div>
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-neutral-300 mb-1.5">Adres e-mail</label>
            <input id="email" type="email" name="email" required placeholder="jan@example.com" class="w-full bg-neutral-950 border border-white/10 text-white placeholder-neutral-600 px-4 py-3 rounded-lg text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors" />
          </div>
          <div>
            <label for="message" class="block text-sm font-semibold text-neutral-300 mb-1.5">Wiadomość</label>
            <textarea id="message" name="message" rows="5" required placeholder="Napisz swoją wiadomość..." class="w-full bg-neutral-950 border border-white/10 text-white placeholder-neutral-600 px-4 py-3 rounded-lg text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-colors resize-none"></textarea>
          </div>

          <div id="turnstile-container" data-sitekey={config.turnstileSiteKey}></div>
          <p id="turnstile-error" class="hidden text-sm text-red-400">Potwierdź, że nie jesteś robotem.</p>

          <div class="flex items-start gap-3">
            <input type="checkbox" id="rodo" required class="mt-0.5 accent-orange-500" />
            <label for="rodo" class="text-xs text-neutral-500 leading-relaxed">
              Wyrażam zgodę na przetwarzanie moich danych osobowych w celu udzielenia odpowiedzi na moje zapytanie,
              zgodnie z <a href="/polityka-prywatnosci" class="text-orange-400 hover:underline">Polityką prywatności</a>.
            </label>
          </div>

          <p id="form-error" class="hidden text-sm text-red-400 bg-red-500/10 border border-red-500/30 rounded-lg px-4 py-3">
            Coś poszło nie tak. Spróbuj ponownie lub napisz bezpośrednio na
            <a href={`mailto:${config.contact.email}`} class="underline">{config.contact.email}</a>.
          </p>

          <button type="submit" id="form-submit" class="w-full bg-orange-500 hover:bg-orange-400 disabled:opacity-60 disabled:cursor-not-allowed text-black font-bold py-3.5 rounded-lg transition-colors text-sm">
            Wyślij wiadomość
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('form-submit') as HTMLButtonElement | null;
  const successBox = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');
  const turnstileError = document.getElementById('turnstile-error');

  // Cloudflare Turnstile - loaded and rendered explicitly. The token is a
  // client-side gate only: it is deliberately NOT sent to web3forms, whose
  // free plan 400s ("You are trying to use a Pro feature") the moment
  // `cf-turnstile-response` is in the payload. Server-side, the honeypot is
  // the check that actually runs.
  type TurnstileApi = {
    render: (
      el: HTMLElement,
      opts: {
        sitekey: string;
        theme: string;
        appearance: string;
        callback: (token: string) => void;
        'expired-callback': () => void;
        'error-callback': () => void;
      },
    ) => string;
    reset: (id: string) => void;
  };
  let widgetId: string | undefined;
  let turnstileToken: string | null = null;

  function setTurnstileToken(token: string | null) {
    turnstileToken = token;
    if (submitBtn) submitBtn.disabled = token === null;
    if (token) turnstileError?.classList.add('hidden');
  }

  function renderTurnstile() {
    const container = document.getElementById('turnstile-container');
    const w = window as unknown as { turnstile?: TurnstileApi };
    if (container && container.dataset.sitekey && w.turnstile && widgetId === undefined) {
      widgetId = w.turnstile.render(container, {
        sitekey: container.dataset.sitekey,
        theme: 'dark',
        appearance: 'always',
        callback: setTurnstileToken,
        'expired-callback': () => setTurnstileToken(null),
        'error-callback': () => setTurnstileToken(null),
      });
    }
  }

  if (document.querySelector('script[src*="challenges.cloudflare.com/turnstile"]')) {
    renderTurnstile();
  } else {
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.onload = renderTurnstile;
    document.head.appendChild(script);
  }

  function resetTurnstile() {
    const w = window as unknown as { turnstile?: TurnstileApi };
    if (widgetId !== undefined) w.turnstile?.reset(widgetId);
    setTurnstileToken(null);
  }

  function setSubmitting(submitting: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = submitting || turnstileToken === null;
    submitBtn.textContent = submitting ? 'Wysyłanie…' : 'Wyślij wiadomość';
  }

  function showSuccess(show: boolean) {
    successBox?.classList.toggle('hidden', !show);
    form?.classList.toggle('hidden', show);
  }

  // Gate submit on Turnstile; the widget callback re-enables it once solved.
  if (submitBtn) submitBtn.disabled = true;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox?.classList.add('hidden');
    turnstileError?.classList.add('hidden');

    const values = new FormData(form);

    // Honeypot: real users never see or tick this. Bots that fill every field
    // get a silent fake-success instead of a delivered message.
    if ((form.elements.namedItem('botcheck') as HTMLInputElement | null)?.checked) {
      showSuccess(true);
      return;
    }

    if (turnstileToken === null) {
      turnstileError?.classList.remove('hidden');
      return;
    }

    setSubmitting(true);

    // Build the payload from an explicit allowlist so nothing unexpected
    // (the honeypot, the Turnstile token, the RODO checkbox) reaches web3forms.
    const body = new FormData();
    body.append('access_key', String(values.get('access_key') ?? ''));
    body.append('subject', String(values.get('subject') ?? ''));
    body.append('name', String(values.get('name') ?? ''));
    body.append('email', String(values.get('email') ?? ''));
    const phone = String(values.get('phone') ?? '');
    if (phone) body.append('phone', phone);
    body.append('message', String(values.get('message') ?? ''));

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body,
      });
      const data = await res.json();
      if (data.success) {
        showSuccess(true);
        form.reset();
        resetTurnstile();
      } else {
        errorBox?.classList.remove('hidden');
        resetTurnstile();
      }
    } catch {
      errorBox?.classList.remove('hidden');
      resetTurnstile();
    } finally {
      setSubmitting(false);
    }
  });

  document.getElementById('form-send-another')?.addEventListener('click', () => showSuccess(false));
</script>
