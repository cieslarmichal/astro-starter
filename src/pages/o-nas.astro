---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { config } from '../config';
import { createBreadcrumbStructuredData } from '../lib/structuredData';
import { imageDimensionsFor } from '../lib/imageDimensions';

const title = `O nas — ${config.siteName}`;
const description = `Poznaj zespół ${config.siteName} - kim jesteśmy i dlaczego klienci nam ufają.`;
const canonical = `${config.siteUrl}/o-nas`;

const jsonLd = [
  createBreadcrumbStructuredData([
    { name: 'Strona główna', url: config.siteUrl },
    { name: 'O nas', url: canonical },
  ]),
];

const team = [
  { name: 'Jan Kowalski', role: 'Współzałożyciel', image: '/team-1.webp' },
  { name: 'Maria Zielińska', role: 'Head of Delivery', image: '/team-2.webp' },
  { name: 'Piotr Wójcik', role: 'Lead Consultant', image: '/team-3.webp' },
];
const dims = await imageDimensionsFor(team, (m) => m.image);
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <PageHeader
    label="O nas"
    title="Kim jesteśmy?"
    description="Zespół ludzi, który wolałby zrobić coś dobrze raz, niż byle jak trzy razy."
  />

  <section class="bg-black py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center mb-24">
        <div>
          <p class="text-orange-400 text-sm font-semibold uppercase tracking-widest mb-3">Nasza misja</p>
          <h2 class="text-3xl font-bold text-white mb-6">Robimy mniej rzeczy, ale robimy je dobrze</h2>
          <p class="text-neutral-400 leading-relaxed mb-4">
            {config.legalName} powstało z przekonania, że większość projektów nie upada przez brak pomysłów, tylko
            przez brak jasnej priorytetyzacji i komunikacji. Dlatego zaczynamy od pytań, nie od gotowych odpowiedzi.
          </p>
          <p class="text-neutral-400 leading-relaxed">
            Pracujemy z klientami, którzy cenią sobie konkretną, mierzalną wartość - nie tylko ładną prezentację na
            koniec kwartału.
          </p>
        </div>
        <div class="overflow-hidden rounded-2xl border border-white/10">
          <img src="/about-1.webp" alt="Zespół przy pracy" width="1600" height="1067" class="w-full h-auto object-cover" loading="lazy" />
        </div>
      </div>

      <div>
        <p class="text-orange-400 text-sm font-semibold uppercase tracking-widest mb-3 text-center">Zespół</p>
        <h2 class="text-3xl font-bold text-white text-center mb-12">Ludzie, z którymi będziesz pracować</h2>
        <div class="grid sm:grid-cols-3 gap-8">
          {
            team.map((member) => (
              <div>
                <div class="aspect-4/5 overflow-hidden rounded-2xl mb-4 bg-neutral-900 border border-white/10">
                  <img
                    src={member.image}
                    alt={member.name}
                    width={dims.get(member)?.width}
                    height={dims.get(member)?.height}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <p class="font-bold text-white">{member.name}</p>
                <p class="text-sm text-neutral-500">{member.role}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>
