---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { config } from '../../config';
import { services } from '../../data/services';
import { createItemListStructuredData, createBreadcrumbStructuredData } from '../../lib/structuredData';
import { localImage, absoluteImageUrl } from '../../lib/images';

const title = `Oferta — ${config.siteName}`;
const description = `Zobacz, jak ${config.siteName} może pomóc Twojej firmie - strategia, wdrożenie i wsparcie w jednym miejscu.`;
const canonical = `${config.siteUrl}/oferta`;

const listItems = await Promise.all(
  services.map(async (s) => ({
    name: s.name,
    url: `${config.siteUrl}/oferta/${s.slug}`,
    image: s.image ? await absoluteImageUrl(s.image) : undefined,
    description: s.shortDescription,
  })),
);

const jsonLd = [
  createItemListStructuredData(listItems),
  createBreadcrumbStructuredData([
    { name: 'Strona główna', url: config.siteUrl },
    { name: 'Oferta', url: canonical },
  ]),
];
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <PageHeader label="Oferta" title="W czym możemy pomóc" description="Trzy obszary, w których najczęściej pracujemy z klientami - każdy można zamówić osobno." />

  <section class="bg-black py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div class="grid md:grid-cols-3 gap-8">
        {
          services.map((s) => (
            <a href={`/oferta/${s.slug}`} class="group block bg-neutral-950 border border-white/10 rounded-2xl overflow-hidden hover:border-orange-500/40 transition-all">
              {s.image && (
                <div class="aspect-4/3 overflow-hidden bg-neutral-900">
                  <Image
                    src={localImage(s.image)}
                    alt={s.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6">
                <h2 class="text-lg font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">{s.name}</h2>
                <p class="text-sm text-neutral-400 leading-relaxed mb-4">{s.shortDescription}</p>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-orange-400">
                  Dowiedz się więcej <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
