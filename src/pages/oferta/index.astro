---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import { config } from '../../config';
import { services } from '../../data/services';
import { createItemListStructuredData, createBreadcrumbStructuredData } from '../../lib/structuredData';
import { imageDimensionsFor } from '../../lib/imageDimensions';

const title = `Oferta — ${config.siteName}`;
const description = `Zobacz, jak ${config.siteName} może pomóc Twojej firmie - strategia, wdrożenie i wsparcie w jednym miejscu.`;
const canonical = `${config.siteUrl}/oferta`;

const jsonLd = [
  createItemListStructuredData(
    services.map((s) => ({ name: s.name, url: `${config.siteUrl}/oferta/${s.slug}`, image: s.image, description: s.shortDescription })),
  ),
  createBreadcrumbStructuredData([
    { name: 'Strona główna', url: config.siteUrl },
    { name: 'Oferta', url: canonical },
  ]),
];

const dims = await imageDimensionsFor(services.filter((s) => s.image), (s) => s.image!);
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <PageHeader label="Oferta" title="W czym możemy pomóc" description="Trzy obszary, w których najczęściej pracujemy z klientami - każdy można zamówić osobno." />

  <section class="bg-white py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div class="grid md:grid-cols-3 gap-8">
        {
          services.map((s) => (
            <a href={`/oferta/${s.slug}`} class="group block border border-neutral-200 rounded-2xl overflow-hidden hover:border-orange-300 hover:shadow-lg transition-all">
              {s.image && (
                <div class="aspect-4/3 overflow-hidden bg-neutral-100">
                  <img
                    src={s.image}
                    alt={s.name}
                    width={dims.get(s)?.width}
                    height={dims.get(s)?.height}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6">
                <h2 class="text-lg font-bold text-neutral-900 mb-2 group-hover:text-orange-600 transition-colors">{s.name}</h2>
                <p class="text-sm text-neutral-500 leading-relaxed mb-4">{s.shortDescription}</p>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-neutral-900 group-hover:text-orange-600 transition-colors">
                  Dowiedz się więcej <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
